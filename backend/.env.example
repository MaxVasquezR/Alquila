PORT=3000
NODE_ENV=development
DB_DRIVER=sqlite
SQLITE_PATH=data/alquila.sqlite
API_BASE_URL=http://localhost:3000
APP_URL=http://localhost:5173
SEED_DEMO_DATA=true
# Para PostgreSQL (producción / Docker):
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://alquila:alquila@localhost:5432/alquila_dev
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
LOCATION_FUZZ_RADIUS_METERS=500
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ORIGIN=http://localhost:5173
KYC_WEBHOOK_SECRET=change-me-too
LISTING_FEE_PEN=4
LISTING_DURATION_DAYS=30
FIRST_LISTING_WINDOW_DAYS=30
SUPER_PROMO_FEE_PEN=14
SUPER_PROMO_DURATION_DAYS=7
MAX_PRODUCT_IMAGES=3
MAX_PRODUCT_IMAGE_BYTES=4194304
# SMTP real para verificación de correo:
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=change-me
SMTP_FROM=Alquila <no-reply@tu-dominio.com>
# Cloudinary opcional para media externa
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
